{
  "rewrites": [
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/((?!api/|\\.well-known/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/update-stocks",
      "schedule": "0 23 * * 0-4"
    }
  ]
}
